        <div class="modal-content" onclick="event.stopPropagation()">
            <h3 id="modal-title">Название</h3>
            <p id="modal-text">Описание...</p>
            <button class="close-btn" onclick="closeModal()">Закрыть</button>
        </div>
    </div>

    <script>
        function showInfo(title, text) {
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-text').textContent = text;
            document.getElementById('modal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('modal').style.display = 'none';
        }

        document.getElementById('searchInput').addEventListener('input', filterCards);
        document.getElementById('filterSelect').addEventListener('change', filterCards);

        function filterCards() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const filterValue = document.getElementById('filterSelect').value;
            const cards = document.querySelectorAll('.card');

            cards.forEach(card => {
                const name = card.querySelector('p').textContent.toLowerCase();
                // Используем alt-атрибут изображения для определения категории
                const category = card.querySelector('img').alt.toLowerCase();

                let matchesSearch = name.includes(searchTerm) || category.includes(searchTerm);
                let matchesFilter = true;

                if (filterValue === 'orchid') {
                    matchesFilter = category.includes('орхидея');
                } else if (filterValue === 'succulent') {
                    matchesFilter = category.includes('алоэ');
                } else if (filterValue === 'herb') {
                    matchesFilter = category.includes('розмарин');
                } else if (filterValue === 'cactus') {
                    matchesFilter = category.includes('кактус');
                } else if (filterValue === 'fruit') {
                    matchesFilter = category.includes('манго');
                } else if (filterValue === 'vegetable') {
                    matchesFilter = category.includes('помидор') || category.includes('лук') || category.includes('перец') || category.includes('овощ');
                } else if (filterValue === 'garden') {
                    matchesFilter = category.includes('помидор') || category.includes('лук') || category.includes('перец') || category.includes('овощ') || category.includes('ягода') || category.includes('корнеплод') || category.includes('бобовые');
                } else if (filterValue === 'indoor') {
                    matchesFilter = category.includes('орхидея') || category.includes('алоэ') || category.includes('кактус') || category.includes('трава');
                } else if (filterValue === 'mixed') {
                    matchesFilter = category.includes('розмарин'); // Пример универсального растения
                } else if (filterValue === 'berry') {
                    matchesFilter = category.includes('ягода');
                } else if (filterValue === 'tree') {
                     matchesFilter = category.includes('манго') || category.includes('цитрус');
                } else if (filterValue === 'root') {
                     matchesFilter = category.includes('корнеплод') || category.includes('луковичные');
                } else if (filterValue === 'legume') {
                     matchesFilter = category.includes('бобовые');
                } else if (filterValue === 'citrus') {
                     matchesFilter = category.includes('цитрус');
                } else if (filterValue === 'grass') {
                     matchesFilter = category.includes('трава');
                } else if (filterValue === 'medicinal') {
                     matchesFilter = category.includes('череда') || category.includes('алоэ') || category.includes('мята');
                } else if (filterValue === 'aromatic') {
                     matchesFilter = category.includes('розмарин') || category.includes('базилик') || category.includes('мята');
                } // Добавьте другие условия фильтрации по мере необходимости

                card.style.display = (matchesSearch && matchesFilter) ? 'block' : 'none';
            });
        }
    </script>
</body>
</html>
